# ---------- App ----------
ENV=development                      # development | production
LOG_LEVEL=INFO
APP_NAME=CareerMatch
CORS_ORIGINS=http://localhost:5173   # comma separated; add your deployed frontend URL later

# ---------- Database (Postgres with pgvector) ----------
POSTGRES_USER=careermatch
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=careermatch
POSTGRES_HOST_PORT=5433
# For local host runs outside docker (docker compose overrides host to 'db')
DATABASE_URL=postgresql+psycopg://careermatch:change_me_locally@localhost:5433/careermatch
CHECKPOINT_DB_URL=postgresql://careermatch:change_me_locally@localhost:5433/careermatch

# ---------- Auth ----------
JWT_SECRET=                          # generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080    # 7 days

# ---------- LLM provider ----------
LLM_PROVIDER=gemini                  # gemini | openai
GOOGLE_API_KEY=                      # free key: https://aistudio.google.com/apikey
LLM_MODEL=gemini-2.5-flash           # check AI Studio for the current fast model name
LLM_RERANK_MODEL=gemini-2.5-flash    # can be a stronger model if you have quota
EMBEDDING_MODEL=gemini-embedding-001 # check docs for the current embedding model name
EMBEDDING_DIM=768                    # must match the vector(...) column; changing it needs a re-embed
OPENAI_API_KEY=                      # optional, only if LLM_PROVIDER=openai
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60

# ---------- Job ingestion ----------
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=60
INGEST_SOURCES=remotive,arbeitnow    # add adzuna if you set the keys below
INGEST_MAX_JOBS_PER_SOURCE=500
JOB_STALE_AFTER_DAYS=14              # jobs not seen for this long become inactive
ADZUNA_APP_ID=                       # optional: https://developer.adzuna.com (free tier)
ADZUNA_APP_KEY=                      # optional
ADZUNA_COUNTRY=in                    # in = India
ADMIN_TOKEN=                         # secret token for POST /admin/ingest/run

# ---------- Matching knobs ----------
MATCH_VECTOR_TOPK=100
MATCH_FTS_TOPK=100
MATCH_RERANK_TOPN=15
MATCH_USE_LLM_RERANK=true

# ---------- Optional observability ----------
LANGFUSE_PUBLIC_KEY=                 # optional: https://langfuse.com (free cloud tier)
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000

